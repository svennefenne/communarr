# Copy to .env next to docker-compose.yml and fill in.

# Your time zone (reminders, birthdays, calendar files)
TZ=Europe/Stockholm

# Who owns the files in the data folder (run `id` on the server to see yours)
PUID=1000
PGID=1000

# Where Hooden keeps everything (back this folder up)
HOODEN_DATA=./data
HOODEN_PORT=3000

# The address people use. Needed for invite links and calendar feeds behind a proxy.
PUBLIC_URL=https://hooden.example.com

# --profile https (Caddy): your domain, pointing at your home IP (ports 80 and 443 forwarded)
HOODEN_DOMAIN=hooden.example.com

# --profile tunnel (Cloudflare Tunnel): the tunnel's token, and where Cloudflare puts the visitor's address
CLOUDFLARE_TUNNEL_TOKEN=
# TRUSTED_IP_HEADER=cf-connecting-ip

# --profile turn (coturn) and voice chat: the TURN server everyone's calls can use
VOICE_TURN_URL=turn:hooden.example.com:3478
VOICE_TURN_USER=hooden
VOICE_TURN_PASS=pick-a-long-random-password
