# Copy to .env next to docker-compose.yml and fill in.
# Lines starting with # are off; remove the # to use one.

# Your time zone (reminders, birthdays, calendar files)
TZ=Europe/Stockholm

# Who owns the files in the data folder (run `id` on the server to see yours)
PUID=1000
PGID=1000

# Where Hooden keeps everything (back this folder up)
HOODEN_DATA=./data
# The port on the server; 127.0.0.1:3000 keeps it off your network (HTTPS profiles don't need it)
HOODEN_PORT=3000

# The extras to run, so a plain `docker compose up -d` starts them: https, tunnel, turn
# COMPOSE_PROFILES=tunnel

# The address people use, once it has HTTPS (invite links, calendar feeds, push)
# PUBLIC_URL=https://hooden.example.com

# https profile (Caddy): your domain, pointing at your home IP (ports 80 and 443 forwarded)
# HOODEN_DOMAIN=hooden.example.com

# tunnel profile (Cloudflare Tunnel): the tunnel's token, and where Cloudflare puts the visitor's address
# CLOUDFLARE_TUNNEL_TOKEN=
# TRUSTED_IP_HEADER=cf-connecting-ip

# turn profile (coturn), so voice works for phones on mobile data.
# VOICE_TURN_URL must reach your home IP directly: behind a Cloudflare Tunnel use a separate
# DNS-only (grey cloud) name such as turn.example.com, or your public IP.
# VOICE_TURN_URL=turn:turn.example.com:3478
# VOICE_TURN_USER=hooden
# VOICE_TURN_PASS=pick-a-long-random-password
# the server's own address on your network (the one you reserved in the router)
# VOICE_TURN_LAN_IP=192.168.1.50
# your public IP, only if it never changes or can't be looked up (empty = look it up)
# VOICE_TURN_PUBLIC_IP=
